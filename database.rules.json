{
  "rules": {
    ".read": false,
    ".write": false,
    "branch2": {
      "categories": {
        ".read": "auth != null && (auth.uid == 'REPLACE_WITH_KIOSK_UID_1' || auth.uid == 'REPLACE_WITH_KIOSK_UID_2')"
      },
      "appSettings": {
        ".read": "auth != null && (auth.uid == 'REPLACE_WITH_KIOSK_UID_1' || auth.uid == 'REPLACE_WITH_KIOSK_UID_2')"
      },
      "inventory": {
        ".read": "auth != null && (auth.uid == 'REPLACE_WITH_KIOSK_UID_1' || auth.uid == 'REPLACE_WITH_KIOSK_UID_2')",
        "$category": {
          "$item": {
            "sizes": {
              "$size": {
                "stock": {
                  ".write": "auth != null && (auth.uid == 'REPLACE_WITH_KIOSK_UID_1' || auth.uid == 'REPLACE_WITH_KIOSK_UID_2') && data.exists() && data.isNumber() && newData.isNumber() && newData.val() >= 0 && newData.val() < data.val()"
                }
              }
            }
          }
        }
      },
      "logs": {
        "$orderId": {
          ".read": "auth != null && (auth.uid == 'REPLACE_WITH_KIOSK_UID_1' || auth.uid == 'REPLACE_WITH_KIOSK_UID_2') && (!data.exists() || data.child('submittedByUid').val() == auth.uid)",
          ".write": "auth != null && (auth.uid == 'REPLACE_WITH_KIOSK_UID_1' || auth.uid == 'REPLACE_WITH_KIOSK_UID_2') && !data.exists() && newData.child('submittedByUid').val() == auth.uid",
          ".validate": "newData.hasChildren(['orderId','submittedByUid','orderNumber','customerName','items','total','paymentMethod','paymentStatus','timestamp']) && newData.child('orderId').val() == $orderId && $orderId.matches(/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/) && ((newData.child('paymentMethod').val() == 'QR_CODE' && newData.child('paymentStatus').val() == 'CUSTOMER_REPORTED_PAID') || (newData.child('paymentMethod').val() == 'COUNTER' && newData.child('paymentStatus').val() == 'PAY_AT_COUNTER'))",
          "orderId": { ".validate": "newData.isString() && newData.val() == $orderId" },
          "submittedByUid": { ".validate": "newData.isString() && newData.val() == auth.uid" },
          "orderNumber": { ".validate": "newData.isString() && newData.val().matches(/^[A-F0-9]{8}$/)" },
          "customerName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
          "total": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
          "paymentMethod": { ".validate": "newData.val() == 'QR_CODE' || newData.val() == 'COUNTER'" },
          "paymentStatus": { ".validate": "newData.val() == 'CUSTOMER_REPORTED_PAID' || newData.val() == 'PAY_AT_COUNTER'" },
          "timestamp": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000" },
          "items": {
            ".validate": "newData.hasChildren()",
            "$line": {
              ".validate": "$line.matches(/^([0-9]|[1-8][0-9]|9[0-8])$/) && newData.hasChildren(['name','size','quantity','price','subtotal']) && newData.child('subtotal').val() == newData.child('price').val() * newData.child('quantity').val()",
              "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
              "size": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "quantity": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99" },
              "price": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
              "subtotal": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
